{
  "name": "loar-fullstack",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo -F web -F server -F indexer dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "sc:test": "turbo run sc:test",
    "sc:test:cov": "turbo run sc:test:cov",
    "sc:test:integration": "turbo run sc:test:integration",
    "deploy:sepolia": "bash scripts/deploy-sepolia.sh",
    "sync:addresses": "tsx scripts/rebuild-deployments.ts --apply",
    "check:addresses": "tsx scripts/check-addresses.ts",
    "smoke": "tsx scripts/smoke/index.ts",
    "seed:voices": "pnpm -F server exec tsx scripts/seed-voice-library.ts",
    "docs:pricing": "tsx scripts/generate-pricing-doc.ts",
    "reconcile:spend": "tsx scripts/reconcile-provider-spend.ts",
    "registry:check-staleness": "tsx scripts/check-registry-staleness.ts",
    "cost:check-drift": "tsx scripts/check-cost-drift.ts",
    "ops:firebase-doctor": "tsx scripts/firebase-doctor.ts",
    "smoke:chain": "SMOKE_LAYER=chain tsx scripts/smoke/index.ts",
    "smoke:server": "SMOKE_LAYER=server tsx scripts/smoke/index.ts",
    "smoke:launchpad": "SMOKE_LAYER=launchpad tsx scripts/smoke/index.ts",
    "smoke:voice": "SMOKE_LAYER=voice-studio tsx scripts/smoke/index.ts",
    "smoke:matrix": "SMOKE_LAYER=model-matrix tsx scripts/smoke/index.ts",
    "smoke:ci": "tsx scripts/smoke/index.ts --json",
    "qa:visual": "tsx scripts/qa-visual/index.ts",
    "qa:visual:shots": "tsx scripts/qa-visual/index.ts --no-review"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fal-ai/serverless-client": "^0.15.0",
    "@metaplex-foundation/umi-web3js-adapters": "^0.9.2",
    "@solana/spl-token-metadata": "^0.1.6",
    "@wagmi/cli": "^0.0.0-canary-20251023193249",
    "dotenv": "^16.6.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "playwright": "^1.59.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.2",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "protobufjs@<8.6.0": "8.6.6",
      "hono@<4.12.34": "4.12.34",
      "@hono/node-server@<1.19.15": "1.19.15",
      "@modelcontextprotocol/sdk@<1.25.2": ">=1.25.2",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "axios@>=1.15.2 <1.18.0": "1.18.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "follow-redirects@<=1.15.11": ">=1.15.12",
      "defu@<6.1.5": ">=6.1.5",
      "drizzle-orm@<0.45.2": ">=0.45.2",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "form-data@<2.5.6": "2.5.6",
      "form-data@>=3.0.0 <3.0.5": "3.0.5",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "ip-address@<=10.3.0": "10.3.1",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "kysely@<0.28.17": "0.28.17",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "sharp@<0.35.3": "0.35.3",
      "shell-quote@<=1.8.4": "1.9.0",
      "socket.io-parser@>=4.0.0 <4.2.7": "4.2.7",
      "tar@<=7.5.20": "7.5.21",
      "undici@>=6.0.0 <6.28.0": "6.28.0",
      "vite@<6.4.3": "6.4.3",
      "ponder>vite": "6.4.3",
      "ponder>vite-node": "1.0.2",
      "vitest@<3.2.6": "3.2.6",
      "websocket-driver@<0.7.5": "0.7.5",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "fast-xml-builder@<=1.1.6": ">=1.1.7",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": ">=7.29.4",
      "@noble/hashes": "1.8.0",
      "@opentelemetry/core@<2.8.0": "2.8.0",
      "rpc-websockets": "^10.0.0",
      "dompurify@<3.4.13": "3.4.13",
      "uuid@<11.1.1": "11.1.1",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@metaplex-foundation/mpl-core>@noble/hashes": "1.8.0"
      }
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-r5fr-rjxr-66jc",
        "GHSA-3gc7-fjrx-p6mg",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    },
    "patchedDependencies": {}
  }
}
