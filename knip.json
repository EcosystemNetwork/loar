{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/dist/**",
    "**/generated/**",
    "packages/abis/dist/**",
    "packages/abis/src/generated.ts",
    "apps/indexer/generated/**",
    "apps/indexer/abis/**",
    "apps/*/dist/**"
  ],
  "ignoreDependencies": ["forge-std"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts", "wagmi.config.ts", "ecosystem.config.cjs"],
      "project": ["scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "e2e/**/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "app.config.{js,ts}", "metro.config.js", "babel.config.js"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/server": {
      "entry": [
        "src/index.ts",
        "src/workers/*.ts",
        "scripts/**/*.{ts,mjs}",
        "src/scripts/**/*.ts",
        "*.{ts,mjs}"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}"]
    },
    "apps/indexer": {
      "entry": ["ponder.config.ts", "ponder.schema.ts", "src/api/index.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/event-listener": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/mcp": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/mcp-gateway": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/contracts": {
      "entry": ["script/**/*.ts", "deploy.sh"],
      "project": ["script/**/*.ts"]
    },
    "packages/shared": {
      "entry": ["src/**/index.ts", "src/trpc.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/abis": {
      "entry": ["src/generated.ts", "src/addresses.ts", "src/chain.ts", "src/solana-addresses.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
