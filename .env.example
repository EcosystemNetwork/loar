# ============================================
# LOAR — Root Environment Variables
# ============================================
# LOCAL DEVELOPMENT ONLY — convenience bundle for running all services
# from one place with `pnpm dev`.
#
# Production: each service reads only its own secrets.
#   Server secrets  → apps/server/.env.example
#   Web public vars → apps/web/.env.example
#   Indexer         → apps/indexer/.env.example
#
# Copy this file:  cp .env.example .env

# ============================================
# SERVER — secrets (never expose to browser)
# ============================================

# Secret for signing SIWE session JWTs (generate: openssl rand -hex 32)
SIWE_JWT_SECRET=

# During JWT-secret rotation, set this to the PREVIOUS SIWE_JWT_SECRET for a
# 24h grace window. verifySessionToken() tries the current secret first, then
# falls back to the previous one so in-flight sessions don't all 401 at once.
# Rotation procedure (see apps/server/src/lib/siwe.ts):
#   1. SIWE_JWT_SECRET_PREVIOUS = <current SIWE_JWT_SECRET>
#   2. SIWE_JWT_SECRET          = <new value from `openssl rand -hex 32`>
#   3. Deploy
#   4. After 24h (JWT TTL), remove SIWE_JWT_SECRET_PREVIOUS
# SIWE_JWT_SECRET_PREVIOUS=

# KMS key for envelope-encrypting user-supplied external API keys at rest.
# Keep PROVIDER_KEY_MASTER_KEY during migration so legacy ciphertext remains readable.
PROVIDER_KEY_KMS_KEY_ID=
# Generate legacy fallback: openssl rand -hex 32
PROVIDER_KEY_MASTER_KEY=

# Ed25519 signing key for cross-chain attestation receipts (lib/attestation.ts).
# REQUIRED in production — the server refuses to start attestation without it
# rather than auto-generate a key and persist it to Firestore (R2-2).
# Generate: pnpm --filter server exec node --input-type=module \
#   -e "import b from 'bs58';import{randomBytes}from'node:crypto';console.log((b.default??b).encode(randomBytes(32)))"
# Rotation (same pattern as SIWE_JWT_SECRET): set ATTESTATION_PRIVATE_KEY_PREVIOUS
# to the old value, rotate ATTESTATION_PRIVATE_KEY, deploy, drop PREVIOUS after 90d.
ATTESTATION_PRIVATE_KEY=
# ATTESTATION_PRIVATE_KEY_PREVIOUS=

# Firebase Admin — Firestore access (one is required in production).
# Pick ONE of these two forms:
#   (A) FIREBASE_SERVICE_ACCOUNT — full JSON inline (convenient for CI / env-only platforms)
#   (B) FIREBASE_SERVICE_ACCOUNT_PATH — path to a .json key file
# Without valid creds the server runs in degraded mode (in-memory nonces, no Firestore writes),
# so tRPC mutations like universes.create will fail. Scripts that hit /trpc/universes.create
# also need the server to be started with one of these set.
#
# SECURITY (F1): do NOT keep a real service-account key file inside the repo
# working tree — only .gitignore protects it there, and .dockerignore /
# .railwayignore / editor-sync / tarballs can all still pick it up. Store it
# under ~/.config/loar/ and point FIREBASE_SERVICE_ACCOUNT_PATH at it, or use
# `gcloud auth application-default login` for local admin tooling. The one-off
# scripts under scripts/ default to ~/.config/loar/loar-db-sa.json.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# FIREBASE_SERVICE_ACCOUNT_PATH=/home/you/.config/loar/loar-db-sa.json

FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_STORAGE_TOKEN_SECRET=replace-with-at-least-32-random-characters

NODE_ENV=development
PORT=3000
# Event listener health port (kept separate so `pnpm dev` does not collide with the server)
LISTENER_PORT=3400
# Single URL or comma-separated list for multiple origins (staging, mobile webview, etc.)
CORS_ORIGIN=http://localhost:3001
# Set to 'true' when behind a reverse proxy (nginx, Railway, etc.)
# Enables rate-limit IP extraction from x-forwarded-for / x-real-ip headers.
# Without this, only the socket remote address is used (preventing IP spoofing).
TRUST_PROXY=false
# Set to 'true' to show stack traces in error responses (never enable in production)
# LOAR_DEBUG_ERRORS=false

# Comma-separated allowed domains for SIWE (optional, defaults to CORS_ORIGIN)
# SIWE_ALLOWED_DOMAINS=loar.fun,staging.loar.fun
# Comma-separated chain IDs accepted in SIWE messages. Defaults to
# 11155111 in production, 11155111,31337 in dev (Sepolia, Anvil).
# SIWE_ALLOWED_CHAIN_IDS=11155111

# Admin
ADMIN_WALLET=
# ADMIN_ADDRESSES=0x1234...5678,0xabcd...ef01

# Blockchain — wallet private key for on-chain writes (64 hex chars, no 0x prefix)
# Development only — use KMS_KEY_ID in production (see below)
PRIVATE_KEY=

# AWS KMS — production signing (private key never leaves HSM)
# Create key: aws kms create-key --key-spec ECC_SECG_P256K1 --key-usage SIGN_VERIFY
# IAM policy: kms:Sign, kms:GetPublicKey on the key ARN
# KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/mrk-xxxx
# KMS_REGION=us-east-1

# On-chain payment verification (used by server to validate $LOAR credit purchases)
# RPC_URL falls back to PONDER_RPC_URL_2 if unset — set separately for isolation
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Ethereum mainnet RPC — used for chainId 1 (swaps/trading, tx verification)
# RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Server-side token + treasury addresses (mirrors VITE_ vars but kept server-only)
LOAR_TOKEN_ADDRESS=0x...
TREASURY_ADDRESS=
LOAR_FAUCET_ADDRESS=

# Contract addresses — deployed via: forge script script/DeployAll.s.sol
UNIVERSE_MANAGER=
PAYMENT_ROUTER_ADDRESS=
RIGHTS_REGISTRY_ADDRESS=
SPLIT_ROUTER_ADDRESS=
LAUNCHPAD_STAKING_ADDRESS=
CREDIT_MANAGER_ADDRESS=
SUBSCRIPTION_MANAGER_ADDRESS=
LICENSING_REGISTRY_ADDRESS=
AD_PLACEMENT_ADDRESS=
CANON_MARKETPLACE_ADDRESS=
COLLAB_MANAGER_ADDRESS=
ANALYTICS_REGISTRY_ADDRESS=
STORY_BOUNTIES_ADDRESS=
ESCROW_ADDRESS=
REVENUE_MODULE_FACTORY=
PLATFORM_TREASURY_ADDRESS=

# ── Mainnet handoff (Foundry operator vars) ──────────────────────────
# Only the deploy operator needs these — the server runtime ignores them.
# Used by: script/DeployTimelock.s.sol, DeployTimelockFactory.s.sol,
#          TransferToMultisig.s.sol, VerifyMultisigTransfer.s.sol.
# Full runbook: docs/safe-timelock-runbook.md
#
# Step 1 — Safe deployed manually at app.safe.global. Paste the new address:
# SAFE_ADDRESS=
# Step 2 — TimelockController deployed via DeployTimelock.s.sol. Optional
# override of the 48h default delay (seconds; mainnet must be >= 86400):
# TIMELOCK_DELAY=172800
# TIMELOCK_ADDRESS=
# Step 3 — TimelockFactory bootstrap (TIMELOCK-01..04, audit-fix tracker):
# UNIVERSE_TOKEN_DEPLOYER_ADDRESS=
# TIMELOCK_FACTORY_ADDRESS=
# RENOUNCE_FACTORY_OWNERSHIP=false
# Step 4 — DRY_RUN=true on TransferToMultisig.s.sol logs every transfer
# without broadcasting; flip to false (or omit) when ready to broadcast.
# DRY_RUN=true
#
# Additional contract addresses TransferToMultisig.s.sol expects but the
# server runtime doesn't read (so they live here, not earlier in the block):
# IDENTITY_NFT_ADDRESS=
# FEE_LOCKER_ADDRESS=
# SLOP_MARKET_ADDRESS=
# REMIX_FEES_ADDRESS=
# LOAR_BURNER_ADDRESS=
# CONTENT_LICENSING_ADDRESS=
# NFT beacon addresses (5 upgradeable beacons — see NFT-01 audit fix):
# EPISODE_EDITION_BEACON=
# CHARACTER_NFT_BEACON=
# ENTITY_NFT_BEACON=
# ENTITY_EDITION_BEACON=
# EPISODE_NFT_BEACON=
#
# Foundry RPC + verification keys (mirror the VITE_RPC_* values for the same
# chain). Required by `forge script ... --rpc-url $RPC_1 --verify`:
# RPC_11155111=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# RPC_1=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# VERIFICATION_KEY_11155111=
# VERIFICATION_KEY_1=

# Platform
# UNIVERSE_MINT_CREDITS=5000

# AI Services (optional — server starts without them)
FAL_KEY=
BYTEDANCE_API_KEY=              # ByteDance ModelArk — Seedance 2.0, Seedream 5.0, Seed Speech. Comma-separated for backup keys (rotates on auth/rate-limit failures)
ZAI_API_KEY=                    # Z.AI (https://z.ai) — GLM-4.6 / 5.x chat & reasoning, GLM-5V vision, CogView-4 image, CogVideoX-3 video, GLM-ASR transcription, Web Search / Web Reader tools. Comma-separated for rotation.
GROQ_API_KEY=                   # Groq (https://console.groq.com) — Llama 3.x / GPT-OSS / Kimi-K2 / Qwen-3 LLMs + Whisper-Turbo / Distil-Whisper transcription + Orpheus TTS. Cheapest path for high-volume text + EN transcription. Comma-separated for rotation.
GOOGLE_API_KEY=
OPENAI_API_KEY=
MESHY_API_KEY=                  # Meshy — 3D gen + humanoid auto-rig + animation library (Pro tier required for rigging endpoints)
TRIPO_API_KEY=                  # Tripo3D — non-humanoid auto-rig (quadruped, hexapod, octopod, avian, serpentine, aquatic, others/vehicles) + preset animations. https://platform.tripo3d.ai/api-keys
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=                # Deepgram (https://console.deepgram.com) — Nova-3 / Aura-2 transcription + TTS. Optional but unlocks Deepgram caption backend + extra TTS voices.
ASSEMBLYAI_API_KEY=              # AssemblyAI (https://www.assemblyai.com/dashboard) — Universal-2 transcription w/ word-level timestamps + diarization. Optional captions backend.
MINIMAX_API_KEY=                 # MiniMax (https://www.minimax.io/platform) — Hailuo-02 video. Required only when routing to minimax-* rows in video registry.

# ── Local / self-hosted video (ComfyUI) — FREE inference on your own GPU ──
# Point this at a running ComfyUI server. With it set, the comfy-ltx-* rows in
# the video registry render on your machine at $0 (no provider cost, nothing
# leaves the box). The LOAR server fetches the clip from ComfyUI's local /view
# endpoint and pins it to IPFS, so the URL being localhost is fine.
#   Default when unset: http://127.0.0.1:8188
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Optional: use your OWN exported workflows instead of the bundled LTX defaults.
# In ComfyUI: Settings → enable "dev mode" → "Save (API Format)". Then point
# these at the saved JSON. The service injects %prompt% / %negative_prompt% /
# %width% / %height% / %length% / %seed% / %image% placeholders at run time.
# COMFYUI_WORKFLOW_T2V_PATH=/abs/path/to/text-to-video.api.json
# COMFYUI_WORKFLOW_I2V_PATH=/abs/path/to/image-to-video.api.json

# Uniswap Trading API — server-orchestrated swaps (swap-to-buy-credits,
# agent-to-agent swaps) executed via Circle DCW. Get a key at
# https://developers.uniswap.org (Developer Platform → API Keys).
# When unset, the uniswap.* tRPC routes + loar_uniswap_* MCP tools return
# a "not configured" error; the rest of the app is unaffected.
UNISWAP_API_KEY=
# UNISWAP_TRADING_API_BASE=https://trade-api.gateway.uniswap.org/v1
# Optional per-swap input cap in wei (e.g. 1000000000000000000 = 1 ETH).
# UNISWAP_MAX_SWAP_WEI=
# Optional extra Universal Router allowlist for new chains/versions:
#   "chainId:0xrouter,chainId:0xrouter"
# UNISWAP_EXTRA_ROUTERS=

# ── ENS (identity for users + AI agents) ─────────────────────────────
# ENS resolution uses Ethereum mainnet via RPC_URL_MAINNET (above); a public
# node is used if unset. No key required for resolution.
# Parent name that offchain agent subnames are issued under (CCIP-Read):
# ENS_AGENT_PARENT=agents.loar.eth
# Public base URL used when composing agent MCP endpoints in ENS records:
# PUBLIC_BASE_URL=https://loar.fun

# ── Arc (Circle USDC L1) + x402 agent payments ───────────────────────
# Arc testnet RPC (defaults to the public endpoint). USDC is the native gas
# asset (system contract 0x3600…0000). Faucet: https://faucet.circle.com
# ARC_RPC_URL=https://rpc.testnet.arc.network
# x402 paid-call demo (POST /api/x402/echo): recipient + price per call.
# X402_PAY_TO=0xYourTreasuryOrAgentAddress
# X402_PRICE_USDC=0.01

# ── Google Cloud BigQuery (ERC-8004 agent reputation) ────────────────
# Billing project for BigQuery (defaults to the service account's project_id).
# The Firebase service account is reused for auth if it has the BigQuery Job
# User role; otherwise set GCP_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS.
# GCP_PROJECT_ID=
# GCP_SERVICE_ACCOUNT_JSON=
# ERC-8004 registry overrides (default to the EF mainnet deployment):
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# ERC8004_VALIDATION_REGISTRY=

# Unstoppable Domains — reverse-resolve wallet → .crypto/.eth domains in UI
# Get a key at https://unstoppabledomains.com/partner/dashboard
# When unset the /api/ud/reverse endpoint returns null (UI shows truncated address).
UNSTOPPABLE_DOMAINS_API_KEY=

# Storage — Pinata (hot path, public delivery)
PINATA_JWT=
# Cold-load performance note:
#  - Default (unset): clients + the /api/img proxy read from https://ipfs.io,
#    a path-style public gateway that serves our CIDv0 (`Qm…`) content fast.
#    Avoid subdomain-redirect gateways (w3s.link / dweb.link) as the default —
#    they 307 to <cid>.ipfs.<host> which only resolves for CIDv1 and stall
#    ~15s on our CIDv0 hashes.
#  - FASTEST (recommended for prod): set this to your DEDICATED Pinata gateway
#    (https://<your-name>.mypinata.cloud) AND set PINATA_GATEWAY_TOKEN below.
#    The dedicated gateway is token-gated (401 without it), so the token is
#    REQUIRED — the client and proxy bypass a dedicated gateway when no token
#    is available. Alternatively disable Access Controls on the gateway in the
#    Pinata dashboard to make it open, then no token is needed.
# PINATA_GATEWAY_URL=https://<your-name>.mypinata.cloud
# Dedicated Pinata gateways on *.mypinata.cloud require a gateway access token.
# Get one at https://app.pinata.cloud/gateway → your gateway → Access Controls.
# Used by both server (IPFSAdapter) and the client IPFS URL helper.
# PINATA_GATEWAY_TOKEN=

# /api/img image proxy — scaling notes:
#  - PRODUCTION: with a dedicated PINATA_GATEWAY_URL + token (above), the proxy
#    delegates the resize to Pinata's CDN-side image optimization and streams
#    the result — no sharp on the origin, renditions cached on Pinata's edge.
#    Front /api/img with a CDN (Cloudflare/Fastly/platform) — responses are
#    `immutable` + `Vary: Accept`, so the origin is hit ~once per rendition.
#  - The settings below only affect the sharp FALLBACK path (no dedicated
#    gateway, e.g. local dev):
# Max concurrent origin-side sharp transcodes before requests queue (guards CPU
# /memory under bursts). Default 4.
# IMG_MAX_CONCURRENT_TRANSCODES=4
# Disk cache for fallback renditions — persists across restarts. Defaults to
# <os-tmpdir>/loar-img-cache. Set "off" to disable (memory-only) on ephemeral/
# read-only hosts; point at a mounted volume on Railway/Fly for durability.
# IMG_CACHE_DIR=

# Storage — Lighthouse (permanent Filecoin + encrypted assets)
LIGHTHOUSE_API_KEY=

STORAGE_PROVIDER_PRIORITY=pinata,lighthouse,firebase

# Content Provenance — C2PA signing for AI-generated content (optional)
# Generate self-signed cert for testnet:
#   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 \
#     -keyout c2pa-key.pem -out c2pa-cert.pem -days 365 -nodes -subj "/CN=LOAR Platform"
# Values should be PEM-encoded (paste the full -----BEGIN/END----- blocks)
C2PA_PRIVATE_KEY=
C2PA_CERTIFICATE=

# Email — Resend transactional emails (optional, email disabled if unset).
# Required for Circle email sign-in: /auth/circle/register returns 503
# "Email delivery not configured" in production until RESEND_API_KEY is set.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# From-address for OTP sign-in emails (lib/email.ts). Must be on a
# Resend-verified domain; if unset, defaults to onboarding@resend.dev which
# only delivers to the Resend account owner (test only, not real users).
# RESEND_FROM_EMAIL=noreply@loar.fun
# RESEND_FROM_NAME=LOAR
# From-address for notification emails (services/email-notifications.ts).
# FROM_EMAIL=noreply@loar.fun
# Public-facing base URL embedded in DMCA notices, counter-notice deep
# links, and other transactional emails. Defaults to https://loar.fun.
# APP_BASE_URL=https://loar.fun

# Queue — BullMQ generation queue admission control
# MAX_CONCURRENT_GENERATIONS=100
# MAX_QUEUED_GENERATIONS=400
# MAX_INLINE_GENERATIONS_DEGRADED=10          # in-process cap used only while Redis/BullMQ is unreachable
# WORKER_CONCURRENCY=5
# GENERATION_WORKER_DISABLED=true

# Horizontal scaling (production docker-compose) — passed to `docker compose up
# --scale server=N --scale worker=N`. Total concurrent AI jobs =
# WORKER_REPLICAS × WORKER_CONCURRENCY. See docs/scale-readiness-10k.md for
# sizing guidance.
# SERVER_REPLICAS=4
# WORKER_REPLICAS=2

# MCP Server — LOAR platform access for AI agents
# LOAR_SERVER_URL=http://localhost:3000
# LOAR_API_KEY=loar_xxxxxxxxxxxx
# Transport — "stdio" (default, for direct agent wiring) or "http"
# LOAR_MCP_TRANSPORT=stdio
# HTTP transport bind (only used when LOAR_MCP_TRANSPORT=http)
# LOAR_MCP_HOST=0.0.0.0
# LOAR_MCP_PORT=4000

# Redis — BullMQ generation queue + distributed rate limiting.
# REQUIRED for async AI generation. Without it, mutations run inline and
# block the HTTP request for 60s+ (mobile/web will hit gateway timeouts).
# Local dev: `redis-server --daemonize yes` or `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=changeme

# ── Webhook delivery (MCP integration §2) ─────────────────────────────
# HMAC-SHA256 secret used to sign outbound webhook bodies. Generate with:
#   openssl rand -hex 32
# Receivers verify via header `X-Loar-Signature: sha256=<hex>` over
# `${X-Loar-Timestamp}.${body}`. Leave unset to disable webhook delivery
# entirely — `enqueueWebhook()` will silently skip (fail-open for dev).
WEBHOOK_SIGNING_SECRET=
# WEBHOOK_WORKER_CONCURRENCY=10

# Stripe — card payments (server-side secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ERC-4337 Paymaster / gas sponsorship (apps/server/src/routes/paymaster.ts) ──
# Server-side sponsorship for sponsored meta-transactions (mint, vote, universe
# creation). Provider resolved in order: Pimlico → Biconomy. Pick ONE.
# When none are set, /api/paymaster returns 501 and sponsorship is disabled.
#
# Pimlico v2 RPC
# PIMLICO_API_KEY=
# Biconomy v2 RPC
# BICONOMY_API_KEY=
# PAYMASTER_DAILY_LIMIT=50                       # per-wallet sponsored ops per day
# PAYMASTER_DEFAULT_CHAIN_ID=11155111            # falls back when request omits chainId

# ── CSAM / hash-matching providers (apps/server/src/services/fingerprint) ───
# Run before every image publish. At least ONE provider must be configured
# for production — leaving both unset lets hashed CSAM pass the pipeline.
# Microsoft PhotoDNA: https://www.microsoft.com/photodna
# PHOTODNA_ENDPOINT=https://api.microsoftmoderator.com/photodna/v1.0
# PHOTODNA_SUBSCRIPTION_KEY=
# Hive AI moderation: https://thehive.ai
# HIVE_API_KEY=

# Monitoring — Sentry (optional, error reporting disabled if unset)
SENTRY_DSN=

# Structured logging level — one of: trace | debug | info | warn | error | fatal
# Defaults to `debug` in development and `info` in production.
# LOG_LEVEL=info

# Prometheus /metrics endpoint — bearer token for scraper auth. When set,
# scrapers must send `Authorization: Bearer ${METRICS_AUTH_TOKEN}`. Leave empty
# when the server is on a private network or behind a reverse-proxy allowlist.
# METRICS_AUTH_TOKEN=

# Product analytics — PostHog (server side). Use the PROJECT API key here,
# NOT the personal key. When unset, server-side events are a silent no-op.
# See docs/analytics.md for the event catalogue + privacy posture.
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# POSTHOG_HOST=https://us.i.posthog.com

# Slack incoming webhook — operator-actionable alerts (kill-switch flips,
# abuse flags). No-op when unset. Use a channel scoped to ops, not #general.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Cost tracker — admin-only provider cost attribution + gross-margin gauge.
# Target margin = (revenue - cost) / revenue. Flagged below target.
# COST_MARGIN_TARGET=0.30
# Background alert sweep (margin breach + daily platform cap). Opt-in, ONE replica only.
# COST_ALERT_ENABLED=false
# COST_ALERT_INTERVAL_MS=600000                # 10 min
# COST_ALERT_COOLDOWN_MIN=30                   # minutes between repeat alerts for the same rule
# Hard daily platform cost cap. When today's spend reaches this, every paid
# provider call fails fast with CostCapExceededError until the day rolls over
# or an admin raises the cap via admin.cost.controls.update.
# COST_DAILY_PLATFORM_CAP_USD=500
# Controls cache TTL (ms). Admin mutations invalidate immediately.
# COST_CONTROLS_CACHE_MS=30000

# Per-call cost ceilings (USD) — refuse a single request whose modeled unit
# cost exceeds the ceiling. Catches fat-fingered tier bumps and accidental
# 4k / 60s requests on a budget plan. Throws CostCeilingExceededError.
# MAX_LLM_CALL_USD=0.50           # single LLM completion
# MAX_VLM_CALL_USD=1.00           # vision-capable LLM completion
# MAX_IMAGE_CALL_USD=2.00         # one image generation batch
# MAX_VIDEO_CALL_USD=10.00        # one video generation
# MAX_AUDIO_CALL_USD=3.00         # one music/sfx synthesis
# MAX_THREED_CALL_USD=2.00        # one 3D / rig / animation task

# Per-provider concurrency caps (semaphore depths) — caps parallel calls to
# avoid 429 storms on shared platform keys. Defaults are conservative.
# OPENAI_CONCURRENCY=8            # OpenAI chat / Sora
# GEMINI_CONCURRENCY=8            # Gemini chat / Veo / Lyria / Imagen
# ELEVENLABS_CONCURRENCY=4
# BYTEDANCE_CONCURRENCY=8
# ZAI_CONCURRENCY=4
# FAL_CONCURRENCY=12
# GROQ_CONCURRENCY=12
# DEEPGRAM_CONCURRENCY=8
# ASSEMBLYAI_CONCURRENCY=8
# MESHY_CONCURRENCY=4
# TRIPO_CONCURRENCY=4
# MINIMAX_CONCURRENCY=4

# Smoke harness — set SMOKE_LIVE=1 (or run `pnpm smoke:matrix-live`) to opt
# into real provider round-trips. Default skips live calls so `pnpm smoke`
# is safe to run without keys.
# SMOKE_LIVE=0
# SMOKE_LIVE_PAID=0                # require explicit paid-key opt-in

# VLM subsystem — Vision-Language Model intelligence
# See docs/prd-vlm-subsystem.md for the full spec.
# Requires GOOGLE_API_KEY. Server starts without these set; workers/features degrade gracefully.
# VLM_WORKER_DISABLED=false                   # set true to skip the in-process VLM worker
# VLM_WORKER_CONCURRENCY=3
# VLM_AUTO_EXTRACT=true                       # auto-enqueue extract after every generation
# VLM_AUTO_HIDE_HIGH_RISK=false               # hide content when risk=high (requires admin review)
# VLM_EMBEDDINGS=false                        # store text-embedding-004 embeddings on sceneIndex
# VLM_EXTRACT_PER_USER_PER_HOUR=20            # rate limit per user for .start
# VLM_USER_MONTHLY_USD=5                      # per-user monthly VLM budget cap
# VLM_CROSS_MODEL=false                       # ensemble Gemini + OpenAI for high-stakes checks
# VLM_MODERATION_ON_GENERATION=false          # run VLM moderation on every finished generation
# CANON_BLOCK_ON_HIGH=false                   # hard-block publish on block-severity conflicts
# Phase 7 — continuous-film autoplay (opt-in, ONE replica only)
# VLM_CONTINUOUS_FILM=false
# VLM_AUTOPLAY_MAX_PER_DAY=10                 # per universe
# VLM_AUTOPLAY_BUDGET_USD=20                  # per universe / day
# VLM_AUTOPLAY_REQUIRE_VOTE=true              # require on-chain vote before advancing canon

# Abuse detector — opt-in, only enable on ONE replica in multi-replica deploys.
# ABUSE_DETECT_ENABLED=false
# ABUSE_DETECT_INTERVAL_MS=1800000          # 30 min
# ABUSE_DETECT_DAILY_THRESHOLD=100          # spends in 24h before flag
# ABUSE_DETECT_SCAN_LIMIT=500               # most-recent userCredits docs to scan
# ABUSE_DETECT_COOLDOWN_MS=21600000         # 6h — skip re-flagging the same wallet

# DMCA § 512(g) auto-putback — REQUIRED in production, ONE replica only.
# Restores taken-down content when a counter-notice has been pending for
# the hold period with no court action filed. If this job is not running
# in prod, you cannot complete the § 512(g) safe-harbor loop and your
# DMCA defence is incomplete. Set ENABLED=true on exactly one replica.
# DMCA_PUTBACK_ENABLED=true
# DMCA_PUTBACK_INTERVAL_MS=3600000          # 1h sweep
# Business days, not calendar. Statute requires the floor to be in
# [10, 14] business days. The job clamps any value outside that range.
# DMCA_PUTBACK_HOLD_BUSINESS_DAYS=12
# DMCA_PUTBACK_BATCH_LIMIT=50               # counter-notices processed per tick

# ============================================
# WEB — browser-safe vars (VITE_ prefix = public)
# ⚠  Everything with VITE_ is visible in the JS bundle — no secrets here.
# ============================================
VITE_SERVER_URL=http://localhost:3000
VITE_PONDER_URL=http://localhost:42069
# Optional — comma-separated fallback Ponder/GraphQL indexer URLs (tried in order
# on query error or 5xx). Useful for staging→prod failover or mirror replicas.
# VITE_PONDER_URL_FALLBACK=https://idx-backup.loar.fun

# Chain environment. Ethereum only: Sepolia (default) + mainnet.
VITE_CHAIN_ENV=testnet
# Default chain ID (11155111 = Ethereum Sepolia, 1 = Ethereum mainnet)
# VITE_CHAIN_ID=11155111

# Per-chain RPC for wagmi reads. Public viem defaults cap
# eth_getLogs ranges and throttle large eth_call responses — point these
# at Alchemy/Infura/etc. Mirror the server-side RPC_<chainId> values.
VITE_RPC_11155111=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# VITE_RPC_1=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY   # Ethereum mainnet

# Default AI image model (optional, overrides server default)
# VITE_DEFAULT_IMAGE_MODEL=

# Public contract addresses
# Note: $LOAR token + other per-chain addresses live in apps/web/src/configs/addresses.ts
VITE_TREASURY_ADDRESS=
VITE_LOAR_FAUCET_ADDRESS=
VITE_LOAR_TOKEN_ADDRESS=
VITE_UNIVERSE_MANAGER=
VITE_PAYMENT_ROUTER_ADDRESS=
VITE_SPLIT_ROUTER_ADDRESS=
VITE_LAUNCHPAD_STAKING_ADDRESS=
VITE_STORY_BOUNTIES_ADDRESS=

# Client-side Pinata gateway URL — mirrors PINATA_GATEWAY_URL on the server.
# The IPFS URL helper uses this to build retrieval URLs for images/videos.
# The gateway token lives ONLY on the server (PINATA_GATEWAY_TOKEN). At boot
# the web client primes GET /api/ipfs/gateway-config once per session and
# caches the dedicated gateway base + token in localStorage, so first paint
# composes fast dedicated-gateway URLs synchronously instead of starting every
# asset on ipfs.io. Nothing to set here for that path — it reads the server's
# PINATA_GATEWAY_URL. Leave this blank to use the default public gateway.
# VITE_PINATA_GATEWAY_URL=https://gateway.pinata.cloud
# Force the public Pinata gateway even when a dedicated gateway is configured
# above. Set to 'true' when the dedicated gateway is misconfigured so
# thumbnails keep loading via the public fallback.
# VITE_PINATA_PREFER_PUBLIC=false

# Admin toolbar — comma-separated wallet addresses (empty = disabled)
# VITE_ADMIN_ADDRESSES=0x1234...5678,0xabcd...ef01

# WalletConnect — project ID (get from cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=

# Firebase web client config (public web SDK credentials, NOT the admin service account)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe — publishable key (public, safe for browser)
VITE_STRIPE_PUBLISHABLE_KEY=

# Sentry DSN for the web app (public — safe in the client bundle).
# Get from sentry.io/settings/{org}/projects/{project}/keys/.
# VITE_SENTRY_DSN=
# Release identifier surfaced to Sentry — usually the git SHA, injected at
# build time by CI (e.g. `VITE_RELEASE=$(git rev-parse --short HEAD)`).
# VITE_RELEASE=

# Product analytics — PostHog (web). Use the PROJECT API key;
# it's public-safe (write-only, scoped to one project).
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Solana — the chain picker only shows the Solana option (and /solana +
# /bridge become useful) when VITE_SOLANA_CLUSTER is set. Must match the
# server's SOLANA_CLUSTER. Leave unset for an EVM-only build.
# VITE_SOLANA_CLUSTER=devnet
# Public IDs for the /solana status page — match solana-addresses.ts.
# VITE_UNIVERSE_PROGRAM_ID=
# VITE_EPISODE_PROGRAM_ID=
# VITE_PAYMENT_PROGRAM_ID=
# VITE_LOAR_MINT_DEVNET=
# VITE_BUBBLEGUM_TREE_DEVNET=
# VITE_SOLANA_DEMO_UNIVERSE=               # demo Universe PDA for SolanaMintDialog

# ============================================
# MOBILE — Expo (EXPO_PUBLIC_ prefix = bundled into the app)
# ⚠  Everything with EXPO_PUBLIC_ is visible in the JS bundle — no secrets here.
# apps/mobile reads these at build time via `expo-env`.
# ============================================
# EXPO_PUBLIC_SERVER_URL=https://api.loar.fun
# EXPO_PUBLIC_APP_ENV=production                # production | staging | development
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_RELEASE=                          # git SHA injected by CI at build time
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# INDEXER — Ponder
# ============================================
PONDER_RPC_URL_2=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Optional comma-separated fallback RPCs (public fallbacks are always appended)
# PONDER_RPC_FALLBACKS=https://your-backup-rpc.com,https://another-rpc.com
# Which chain to index: only "sepolia" is supported while we run single-chain.
# PONDER_CHAIN=sepolia

# ============================================
# CIRCLE — Developer Controlled Wallets (server-side KMS)
# ============================================
# Each user gets a Circle-managed EOA; the server signs via Circle's KMS so
# users only need email/social credentials. Without all three, /auth/circle/*
# and /api/tx/write return 503.
#
# 1. API key: console.circle.com → Developer Controlled Wallets → API Keys.
#    Value includes the "TEST_API_KEY:" / "LIVE_API_KEY:" prefix — paste verbatim.
CIRCLE_API_KEY=
# 2. Entity secret: generate at console → Configurator, register once, store here.
#    (Circle refuses to sign without it.)
CIRCLE_ENTITY_SECRET=
# 3. Wallet set to create new user wallets in (create one via console or SDK).
CIRCLE_WALLET_SET_ID=
# 4. Optional: extra contract addresses the signing oracle should accept,
#    comma-separated as "chainId:0xaddr". Use ONLY for testnet ad-hoc contracts
#    that aren't in packages/abis (Firestore `universes.tokenAddress` is
#    allowlisted automatically).
# CONTRACT_ALLOWLIST_EXTRA=11155111:0xabc...,1:0xdef...
# 5. Optional (F8): restrict /api/tx/write to specific function selectors on top
#    of the contract allowlist. Comma-separated 4-byte hex. Unset = any selector.
#    e.g. ERC20 transfer + approve: 0xa9059cbb,0x095ea7b3
# TX_PROXY_ALLOWED_SELECTORS=0xa9059cbb,0x095ea7b3

# ============================================
# OAuth — Google social login idToken verification
# ============================================
# /auth/circle/social verifies the idToken against Google's JWKS before
# trusting the email. Leave empty to hide the Google sign-in button.
# Client ID format: "12345-abc.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_ID=
# Frontend needs the same value with VITE_ prefix to render the button.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ============================================
# SOLANA — multi-chain parity (all optional; EVM-only dev ignores this block)
# ============================================
# /api/solana/* write routes 503 until SOLANA_RPC_URL is set AND the CIRCLE_*
# trio above is configured (Solana tx are signed through the same Circle DCW).
# Read-only PDA lookups + /api/solana/config stay reachable without Circle.
# SOLANA_CLUSTER=devnet
# Paid RPC — public Solana RPC is throttled. Helius / Triton / Alchemy.
# SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# SOLANA_RPC_URL_DEVNET=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# SOLANA_RPC_URL_MAINNET=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# HELIUS_API_KEY=                          # bare key — DAS reads + webhook mgmt
# HELIUS_WEBHOOK_SECRET=                   # HMAC secret; also set on the indexer host
# SIWS_ALLOWED_CLUSTERS=devnet             # default: devnet,mainnet-beta
#
# Program IDs — fill after `pnpm -F @loar/programs deploy:devnet`. Canonical
# devnet IDs are in packages/abis/src/solana-addresses.ts; set here only on drift.
# UNIVERSE_PROGRAM_ID=
# EPISODE_PROGRAM_ID=
# PAYMENT_PROGRAM_ID=
# $LOAR SPL mint (Token-2022) — scripts/solana/create-loar-mint.ts
# LOAR_MINT_DEVNET=
# LOAR_MINT_MAINNET=
# Bubblegum cNFT tree — scripts/solana/create-merkle-tree.ts
# BUBBLEGUM_TREE_DEVNET=
# BUBBLEGUM_TREE_MAINNET=
# SOLANA_PAY_RECIPIENT=                    # base58, for /api/solana-pay QR flow
#
# Custodial $LOAR bridge (Solana ↔ EVM) — all-or-nothing, partial config = 503.
# Bootstrap: pnpm -F server tsx scripts/bridge-bootstrap.ts
# SOL_BRIDGE_VAULT_ATA=
# EVM_BRIDGE_VAULT_ADDRESS=
# CIRCLE_BRIDGE_SIGNER_ID_EVM=
# CIRCLE_BRIDGE_SIGNER_ID_SOL=
# BRIDGE_MAX_PER_TX_LOAR=25000
# BRIDGE_MAX_PER_USER_PER_DAY_LOAR=50000
# BRIDGE_MAX_GLOBAL_PER_DAY_LOAR=500000
# BRIDGE_INTENT_TTL_DAYS=7

# ============================================
# SOLANA INDEXER — Helius webhook → Firestore mirror (apps/solana-indexer)
# ============================================
# SOLANA_INDEXER_PORT=42070
# SOLANA_INDEXER_PUBLIC_URL=https://sol-idx.loar.fun   # where Helius POSTs deliveries
# Reuses SOLANA_CLUSTER, HELIUS_API_KEY, HELIUS_WEBHOOK_SECRET, the *_PROGRAM_ID
# vars above, and the Firebase Admin creds. Register the webhook with:
#   pnpm -F @loar/solana-indexer register

# ============================================
# GOVERNANCE — Gnosis Safe + TimelockController
# ============================================
# Deployed via: forge script script/DeployGovernance.s.sol --rpc-url base --broadcast --verify
# SAFE_ADDRESS=0x...                   # 3-of-5 Gnosis Safe multisig
# TIMELOCK_ADDRESS=0x...               # TimelockController (48h delay)

# ============================================
# BACKUP — Firestore disaster recovery
# ============================================
# GCS bucket for Firestore exports (create: gsutil mb gs://your-bucket)
# IAM: service account needs Cloud Datastore Import Export Admin + Storage Admin
FIRESTORE_BACKUP_BUCKET=
# Optional path prefix inside the bucket (default: "backups")
# FIRESTORE_BACKUP_PREFIX=backups

# ============================================
# CONTRACTS — Foundry (see also apps/contracts/.env.example)
# ============================================
# Sepolia testnet
# RPC_11155111=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# VERIFICATION_KEY_11155111=YOUR_ETHERSCAN_API_KEY

# Ethereum mainnet
# RPC_1=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# VERIFICATION_KEY_1=YOUR_ETHERSCAN_API_KEY
# RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

