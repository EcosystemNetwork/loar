# LOAR backend the tools call (tRPC over HTTP) and the service API key —
# create one with: pnpm tsx scripts/create-voice-director-api-key.ts
LOAR_API_BASE=https://api.loar.fun
LOAR_API_KEY=loar_...

# Shared with the LOAR server (VOICE_SESSION_SECRET there must match).
# Generate: openssl rand -hex 32
VOICE_SESSION_SECRET=

# Speech + reasoning providers.
GRADIUM_API_KEY=gsk_...
SAMBANOVA_API_KEY=
# Optional: characters with a metadata.humeVoiceId speak through Hume.
HUME_API_KEY=

# Optional overrides.
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
GRADIUM_DIRECTOR_VOICE_ID=

# Comma-separated browser origins allowed to open the WebSocket.
ALLOWED_ORIGINS=https://loar.fun,http://localhost:5173
