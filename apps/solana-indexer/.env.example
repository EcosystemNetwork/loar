# ============================================
# LOAR Solana Indexer — Environment Variables
# ============================================
# Helius webhook → Anchor event decoder → Firestore mirror. Deployed to
# Fly/Railway (see fly.toml / railway.toml). Local dev shares the root
# .env.example; copy the relevant lines here for a standalone deploy.

# ── Runtime ─────────────────────────────────────────────────────────────────
# NODE_ENV=production
# LOG_LEVEL=info
# HTTP port the webhook receiver listens on (default 42070).
# SOLANA_INDEXER_PORT=42070
# Public HTTPS URL Helius should POST deliveries to — used by `pnpm register`.
SOLANA_INDEXER_PUBLIC_URL=https://sol-idx.loar.fun

# ── Helius ──────────────────────────────────────────────────────────────────
# API key (bare) — used by scripts/register-webhook.ts to create the webhook.
HELIUS_API_KEY=
# HMAC secret Helius signs deliveries with. In production the receiver rejects
# unsigned/invalid deliveries; in dev an unset secret allows them through.
HELIUS_WEBHOOK_SECRET=

# ── Cluster + programs ──────────────────────────────────────────────────────
# SOLANA_CLUSTER=devnet
# Program IDs to subscribe to. Falls back to the address baked into each
# bundled IDL when unset. Match packages/abis/src/solana-addresses.ts.
UNIVERSE_PROGRAM_ID=
EPISODE_PROGRAM_ID=
PAYMENT_PROGRAM_ID=

# ── Firestore (mirror target) ───────────────────────────────────────────────
# Inline service-account JSON, OR a path resolved from the repo root.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-sa-key.json
