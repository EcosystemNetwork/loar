    {
      "name": "route_with_splits",
      "docs": [
        "Route `amount` lamports from the payer through the configured splits.",
        "",
        "Recipients are passed as `remaining_accounts` in the same order as",
        "stored in the Splits PDA. The treasury account (config.treasury) must",
        "be passed in the named accounts. Last recipient receives any rounding",
        "dust so no lamports are stranded in the payer's account."
      ],
      "discriminator": [143, 142, 255, 47, 80, 113, 130, 209],
      "accounts": [
        {
          "name": "payer",
          "writable": true,
          "signer": true
        },
        {
          "name": "config",
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  115, 112, 108, 105, 116, 95, 114, 111, 117, 116, 101, 114, 95, 99, 111, 110, 102,
                  105, 103
                ]
              }
            ]
          }
        },
        {
          "name": "splits",
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [115, 112, 108, 105, 116, 115]
              },
              {
                "kind": "account",
                "path": "splits.entity_hash",
                "account": "Splits"
              }
            ]
          }
        },
        {
          "name": "treasury",
          "docs": ["`config.treasury` in the handler — mismatch trips TreasuryMismatch."],
          "writable": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {
          "name": "amount",
          "type": "u64"
        },
        {
          "name": "platform_fee_bps",
          "type": "u16"
        }
      ]
    },
    {
      "name": "set_splits",
      "docs": [
        "Set the splits configuration for an entity. The caller (signer) is",
        "recorded as the owner. The Splits PDA is unique per entity_hash, so",
        "`init_if_needed` is safe — the seed prevents re-init attacks.",
        "",
        "On first call: caller is recorded as owner. On subsequent calls:",
        "caller must match the stored owner, and the 1-day cooldown must have",
        "elapsed since the last change."
      ],
      "discriminator": [175, 2, 86, 49, 225, 202, 232, 189],
      "accounts": [
        {
          "name": "owner",
          "writable": true,
          "signer": true
        },
        {
          "name": "config",
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  115, 112, 108, 105, 116, 95, 114, 111, 117, 116, 101, 114, 95, 99, 111, 110, 102,
                  105, 103
                ]
              }
            ]
          }
        },
        {
          "name": "splits",
          "writable": true,
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [115, 112, 108, 105, 116, 115]
              },
              {
                "kind": "arg",
                "path": "entity_hash"
              }
            ]
          }
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {
          "name": "entity_hash",
          "type": {
            "array": ["u8", 32]
          }
        },
